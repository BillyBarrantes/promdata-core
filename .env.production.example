# ═══════════════════════════════════════════════════════════════
# Frontend (Next.js) — Production
# Contrato: test_phase6_platform_env_contract.py
# Production exige URLs HTTPS públicas y debug deshabilitado.
# APP_DOMAIN es el host canónico exacto (sin esquema/path); Compose deriva de él
# NEXT_PUBLIC_API_BASE_URL y la configuración pública de Caddy/FastAPI.
# ═══════════════════════════════════════════════════════════════
APP_DOMAIN=app.example.com
NEXT_PUBLIC_SUPABASE_URL=https://your-prod-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-prod-anon-key
# Valor resultante de https://${APP_DOMAIN}; Compose lo construye directamente.
NEXT_PUBLIC_API_BASE_URL=https://app.example.com
NEXT_PUBLIC_DEBUG_MIDDLEWARE=0
NEXT_PUBLIC_SENTRY_DSN=
FRONTEND_PORT=3000
BACKEND_PORT=8000
REDIS_PORT=6379
