# ═══════════════════════════════════════════════════════════════
# Backend (FastAPI + Celery) — Development (local)
# Contrato: test_phase6_platform_env_contract.py
# Placeholders — NUNCA commitear valores reales.
# ═══════════════════════════════════════════════════════════════
APP_DEPLOY_ENV=development
APP_RELEASE_CHANNEL=local
APP_BUILD_VERSION=0.1.0
APP_BUILD_SHA=dev-local-sha
SUPABASE_URL=https://your-dev-project.supabase.co
SUPABASE_KEY=your-dev-service-role-key
SUPABASE_SERVICE_ROLE_KEY=your-dev-service-role-key
SUPABASE_ANON_KEY=your-dev-anon-key
SUPABASE_JWT_SECRET=your-dev-jwt-secret
# Gemini deja de ser el motor de análisis: se conserva SOLO para embeddings
# (Knowledge/RAG + memoria de sesión), que el gateway delega siempre a Gemini.
# Si se omite, el análisis sigue funcionando pero Knowledge/memoria se degradan.
GEMINI_API_KEY=your-dev-gemini-api-key
GEMINI_CLIENT_PROVIDER=genai
GEMINI_VERTEX_PROJECT=your-gcp-project-id
GEMINI_VERTEX_LOCATION=global
# Modelo de análisis activo (proveedor por defecto: DeepSeek).
AI_MODEL_NAME=DeepSeek-V4.1-flash
NARRATIVE_FAST_MODEL_NAME=DeepSeek-V4.1-flash
NARRATIVE_STRICT_MODEL_NAME=DeepSeek-V4.1-flash
# LLM Gateway Multi-Proveedor (gemini | deepseek | openai)
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=DeepSeek-V4.1-flash
OPENAI_API_KEY=your-openai-api-key
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o
# Circuit Breaker + Retry (aplican a Gemini, DeepSeek y OpenAI por igual)
GEMINI_CIRCUIT_BREAKER_ENABLED=true
GEMINI_CIRCUIT_FAILURE_THRESHOLD=15
GEMINI_CIRCUIT_RECOVERY_TIMEOUT_SECONDS=45
GEMINI_CIRCUIT_HALF_OPEN_MAX_CALLS=2
GEMINI_RETRY_MAX_RETRIES=4
GEMINI_RETRY_BASE_DELAY_SECONDS=1.0
GEMINI_RETRY_MAX_DELAY_SECONDS=15.0
GEMINI_RETRY_JITTER_SECONDS=0.5
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
# Debe coincidir con NEXT_PUBLIC_API_BASE_URL de .env.example
BACKEND_PUBLIC_URL=http://localhost:8000
FRONTEND_APP_URL=http://localhost:3000
GOOGLE_DRIVE_CLIENT_ID=your-dev-google-client-id
GOOGLE_DRIVE_CLIENT_SECRET=your-dev-google-client-secret
GOOGLE_DRIVE_SCOPES=openid email profile https://www.googleapis.com/auth/drive.readonly
GOOGLE_DRIVE_WATCH_MODE=polling
GOOGLE_DRIVE_WEBHOOK_CALLBACK_URL=http://localhost:8000/api/v1/connectors/google-drive/webhook
GOOGLE_DRIVE_WEBHOOK_EXPIRATION_SECONDS=604800
GOOGLE_DRIVE_WEBHOOK_RENEWAL_SKEW_SECONDS=3600
MICROSOFT_ONEDRIVE_CLIENT_ID=your-dev-microsoft-client-id
MICROSOFT_ONEDRIVE_CLIENT_SECRET=your-dev-microsoft-client-secret
MICROSOFT_ONEDRIVE_SCOPES=offline_access openid profile email Files.Read User.Read
MICROSOFT_ONEDRIVE_TENANT_ID=common
MICROSOFT_ONEDRIVE_WATCH_MODE=polling
CONNECTOR_WATCHDOG_ENABLED=false
CONNECTOR_AUTO_SYNC_ENABLED=false
CONNECTOR_POLL_INTERVAL_SECONDS=300
RATE_LIMIT_ENABLED=true
RATE_LIMIT_STORAGE_URL=redis://localhost:6379/0
UNIVERSAL_TABULAR_RESULT_SOFT_LIMIT_BYTES=4000000
