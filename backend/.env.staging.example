# ═══════════════════════════════════════════════════════════════
# Backend (FastAPI + Celery) — Staging
# Contrato: test_phase6_platform_env_contract.py
# Staging exige URLs HTTPS públicas y debug deshabilitado.
# ═══════════════════════════════════════════════════════════════
APP_DEPLOY_ENV=staging
APP_RELEASE_CHANNEL=beta
APP_BUILD_VERSION=0.1.0
APP_BUILD_SHA=staging-build-sha
SUPABASE_URL=https://your-staging-project.supabase.co
SUPABASE_KEY=your-staging-service-role-key
SUPABASE_SERVICE_ROLE_KEY=your-staging-service-role-key
SUPABASE_ANON_KEY=your-staging-anon-key
SUPABASE_JWT_SECRET=your-staging-jwt-secret
# Gemini: solo embeddings (Knowledge/RAG + memoria); ya no es el motor de análisis.
GEMINI_API_KEY=your-staging-gemini-api-key
GEMINI_CLIENT_PROVIDER=genai
GEMINI_VERTEX_PROJECT=your-gcp-project-id
GEMINI_VERTEX_LOCATION=global
# LLM Gateway Multi-Proveedor (gemini | deepseek | openai) — análisis en DeepSeek.
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=your-staging-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=DeepSeek-V4.1-flash
AI_MODEL_NAME=DeepSeek-V4.1-flash
NARRATIVE_FAST_MODEL_NAME=DeepSeek-V4.1-flash
NARRATIVE_STRICT_MODEL_NAME=DeepSeek-V4.1-flash
CELERY_BROKER_URL=rediss://your-staging-redis-host:6379/0
CELERY_RESULT_BACKEND=rediss://your-staging-redis-host:6379/0
# Debe coincidir con NEXT_PUBLIC_API_BASE_URL de .env.staging.example
BACKEND_PUBLIC_URL=https://api-staging.promdata.com
FRONTEND_APP_URL=https://staging.promdata.com
GOOGLE_DRIVE_CLIENT_ID=your-staging-google-client-id
GOOGLE_DRIVE_CLIENT_SECRET=your-staging-google-client-secret
GOOGLE_DRIVE_SCOPES=openid email profile https://www.googleapis.com/auth/drive.readonly
GOOGLE_DRIVE_WATCH_MODE=webhook
GOOGLE_DRIVE_WEBHOOK_CALLBACK_URL=https://api-staging.promdata.com/api/v1/connectors/google-drive/webhook
GOOGLE_DRIVE_WEBHOOK_EXPIRATION_SECONDS=604800
GOOGLE_DRIVE_WEBHOOK_RENEWAL_SKEW_SECONDS=3600
MICROSOFT_ONEDRIVE_CLIENT_ID=your-staging-microsoft-client-id
MICROSOFT_ONEDRIVE_CLIENT_SECRET=your-staging-microsoft-client-secret
MICROSOFT_ONEDRIVE_SCOPES=offline_access openid profile email Files.Read User.Read
MICROSOFT_ONEDRIVE_TENANT_ID=common
MICROSOFT_ONEDRIVE_WATCH_MODE=polling
CONNECTOR_WATCHDOG_ENABLED=true
CONNECTOR_AUTO_SYNC_ENABLED=true
CONNECTOR_POLL_INTERVAL_SECONDS=120
RATE_LIMIT_ENABLED=true
RATE_LIMIT_STORAGE_URL=rediss://your-staging-redis-host:6379/0
UNIVERSAL_TABULAR_RESULT_SOFT_LIMIT_BYTES=4000000
