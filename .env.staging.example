# Frontend (Next.js) — Staging
# Contrato: test_phase6_platform_env_contract.py
# Staging exige URLs HTTPS públicas y debug deshabilitado.
# ═══════════════════════════════════════════════════════════════
NEXT_PUBLIC_SUPABASE_URL=https://your-staging-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-staging-anon-key
# Debe coincidir con BACKEND_PUBLIC_URL de backend/.env.staging.example
NEXT_PUBLIC_API_BASE_URL=https://api-staging.promdata.com
NEXT_PUBLIC_DEBUG_MIDDLEWARE=0
NEXT_PUBLIC_SENTRY_DSN=
FRONTEND_PORT=3000
BACKEND_PORT=8000
REDIS_PORT=6379
